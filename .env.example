# Cookie Gemini (bắt buộc) — lấy từ trình duyệt đã đăng nhập gemini.google.com
# DevTools → Application → Cookies → __Secure-1PSID và __Secure-1PSIDTS
SECURE_1PSID=
SECURE_1PSIDTS=

# Kênh thông báo khi dựng xong: auto | macos | telegram | none
# auto = có cấu hình Telegram thì dùng Telegram, không thì hiện thông báo macOS.
NOTIFY_CHANNEL=auto

# Telegram (tuỳ chọn — chỉ cần nếu muốn nhận thông báo cả khi không ngồi trước máy).
# Cách nhanh nhất: uv run python -m notify.setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Đăng YouTube (tuỳ chọn — pipeline mặc định chỉ dựng video, bạn tự up).
# Chỉ dùng khi chạy ./run_daily.sh --upload
# Lưu ý: OAuth project chưa qua audit của Google sẽ bị ép về private dù đặt public.
YOUTUBE_PRIVACY_STATUS=private
# 24 = Entertainment, 22 = People & Blogs, 1 = Film & Animation
YOUTUBE_CATEGORY_ID=24

# Stage 8 (upload.episodes_cli): giờ lên sóng mỗi tập (giờ địa phương) và link
# playlist "nghe trọn bộ" để điền vào mô tả. Tạo playlist tay một lần rồi dán.
YOUTUBE_PUBLISH_HOUR=20
YOUTUBE_PLAYLIST_URL=
AUDIOBOOK_TZ=Asia/Ho_Chi_Minh

# --- 24/09/2026: 3 chủ đề trọng tâm + định dạng FULL -------------------------
# run_daily.sh không tham số = --topic auto --format full.
# full = 1 video 35-45 phút/ngày; episodes = 3 tập 15-20 phút (kiểu 22/09).
AUDIOBOOK_FORMAT=full
# 7 id theo thứ Hai..Chủ nhật. Sau 14 ngày, chủ đề kém nhất (view 48h thấp nhất
# và CTR < 3%, xem `uv run python -m metadata.report`) thì bớt số lần ở đây.
AUDIOBOOK_TOPIC_ROTATION=ho_hang_viet,nghe_la_hong_bien,ho_hang_viet,bo_me_trong_sinh,nghe_la_hong_bien,ho_hang_viet,bo_me_trong_sinh
# (tuỳ chọn) cố định 1 chủ đề thay vì auto
# AUDIOBOOK_TOPIC=ho_hang_viet
# Tên kênh: badge thumbnail + đuôi tiêu đề "[Truyện Audio] <tiêu đề> | <tên kênh>"
CHANNEL_NAME=Audio Truyện
# Playlist theo CHỦ ĐỀ (tạo tay 1 lần rồi dán link hoặc id PLxxx). Stage 8 thêm
# video vào đúng playlist và điền link vào mô tả.
YOUTUBE_PLAYLIST_HO_HANG=
YOUTUBE_PLAYLIST_NGHE_LA=
YOUTUBE_PLAYLIST_BO_ME=
