# Cookie Gemini (bắt buộc) — lấy từ trình duyệt đã đăng nhập gemini.google.com
# DevTools → Application → Cookies → __Secure-1PSID và __Secure-1PSIDTS
SECURE_1PSID=
SECURE_1PSIDTS=

# Kênh thông báo khi dựng xong: auto | macos | telegram | none
# auto = có cấu hình Telegram thì dùng Telegram, không thì hiện thông báo macOS.
NOTIFY_CHANNEL=auto

# Telegram (tuỳ chọn — chỉ cần nếu muốn nhận thông báo cả khi không ngồi trước máy).
# Cách nhanh nhất: uv run python -m notify.setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Đăng YouTube (tuỳ chọn — pipeline mặc định chỉ dựng video, bạn tự up).
# Chỉ dùng khi chạy ./run_daily.sh --upload
# Lưu ý: OAuth project chưa qua audit của Google sẽ bị ép về private dù đặt public.
YOUTUBE_PRIVACY_STATUS=private
# 24 = Entertainment, 22 = People & Blogs, 1 = Film & Animation
YOUTUBE_CATEGORY_ID=24

# Stage 8 (upload.episodes_cli): giờ lên sóng mỗi tập (giờ địa phương) và link
# playlist "nghe trọn bộ" để điền vào mô tả. Tạo playlist tay một lần rồi dán.
YOUTUBE_PUBLISH_HOUR=20
YOUTUBE_PLAYLIST_URL=
AUDIOBOOK_TZ=Asia/Ho_Chi_Minh
