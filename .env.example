# Cookie Gemini (bắt buộc) — lấy từ trình duyệt đã đăng nhập gemini.google.com
# DevTools → Application → Cookies → __Secure-1PSID và __Secure-1PSIDTS
SECURE_1PSID=
SECURE_1PSIDTS=

# Stage 1 (viết truyện): claude | gemini. Bỏ trống thì có ANTHROPIC_API_KEY là
# dùng Claude. Cookie Gemini vẫn cần cho stage 6 (SEO).
ANTHROPIC_API_KEY=
STORY_LLM=
# STORY_LLM_MODEL=claude-opus-5-5
# STORY_LLM_EFFORT=high

# Kênh thông báo khi dựng xong: auto | macos | telegram | none
# auto = có cấu hình Telegram thì dùng Telegram, không thì hiện thông báo macOS.
NOTIFY_CHANNEL=auto

# Telegram (tuỳ chọn — chỉ cần nếu muốn nhận thông báo cả khi không ngồi trước máy).
# Cách nhanh nhất: uv run python -m notify.setup
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Đăng YouTube (tuỳ chọn — pipeline mặc định chỉ dựng video, bạn tự up).
# Chỉ dùng khi chạy ./run_daily.sh --upload
# Lưu ý: OAuth project chưa qua audit của Google sẽ bị ép về private dù đặt public.
YOUTUBE_PRIVACY_STATUS=private
# 24 = Entertainment, 22 = People & Blogs, 1 = Film & Animation
YOUTUBE_CATEGORY_ID=24

# Stage 8 (upload.episodes_cli): giờ lên sóng mỗi tập (giờ địa phương) và link
# playlist "nghe trọn bộ" để điền vào mô tả. Tạo playlist tay một lần rồi dán.
YOUTUBE_PUBLISH_HOUR=20
YOUTUBE_PLAYLIST_URL=
AUDIOBOOK_TZ=Asia/Ho_Chi_Minh

# --- 24/09/2026: 3 chủ đề trọng tâm + định dạng FULL -------------------------
# run_daily.sh không tham số = --topic auto --format full.
# full = 1 video 35-45 phút/ngày; episodes = 3 tập 15-20 phút (kiểu 22/09).
AUDIOBOOK_FORMAT=full
# 7 id theo thứ Hai..Chủ nhật. Sau 14 ngày, chủ đề kém nhất (view 48h thấp nhất
# và CTR < 3%, xem `uv run python -m metadata.report`) thì bớt số lần ở đây.
AUDIOBOOK_TOPIC_ROTATION=ho_hang_viet,nghe_la_hong_bien,ho_hang_viet,bo_me_trong_sinh,nghe_la_hong_bien,ho_hang_viet,bo_me_trong_sinh
# (tuỳ chọn) cố định 1 chủ đề thay vì auto
# AUDIOBOOK_TOPIC=ho_hang_viet
# Tên kênh: badge thumbnail + đuôi tiêu đề "[Truyện Audio] <tiêu đề> | <tên kênh>"
CHANNEL_NAME=Audio Truyện
# Playlist theo CHỦ ĐỀ (tạo tay 1 lần rồi dán link hoặc id PLxxx). Stage 8 thêm
# video vào đúng playlist và điền link vào mô tả.
YOUTUBE_PLAYLIST_HO_HANG=
YOUTUBE_PLAYLIST_NGHE_LA=
YOUTUBE_PLAYLIST_BO_ME=

# Nhạc nền nhẹ dưới giọng đọc (thử nghiệm 09/11/2026). Mặc định TẮT.
#   AUDIOBOOK_BGM=1                       bốc một file trong assets/music/ (sinh bằng: uv run python -m scripts.make_bgm)
#   AUDIOBOOK_BGM=assets/music/pad-am-soft.mp3   dùng đúng file này
#   AUDIOBOOK_BGM_VOLUME=0.15             hệ số âm lượng 0-1 trong Remotion
# AUDIOBOOK_BGM=
# AUDIOBOOK_BGM_VOLUME=0.15

# Stage 0 từ khóa xu hướng (10/11): 1 = bật (mặc định) với --story auto; 0 = lấy thẳng truyện trong kho.
# Cấu hình hạt giống, kênh đối thủ, ngưỡng điểm ở config/keywords.yaml.
# AUDIOBOOK_KEYWORDS=1

# Đoạn "Mở đầu" kể trước cao trào (26/10). TẮT từ 17/11 (đánh giá kênh: 30 giây đầu vào
# thẳng cảnh tiêu đề hứa, không dẫn dắt). Đặt 1 để bật lại khi muốn so sánh.
# AUDIOBOOK_PROLOGUE=0

# Đánh giá kênh 19/11: giữ 3-4 truyện/tuần, dừng Shorts "Trích đoạn".
# Lượt tự động (--upload) chỉ chạy và chỉ hẹn giờ vào các thứ này (0 = Thứ 2 ... 6 = Chủ nhật);
# video đang hẹn vào thứ khác bị bỏ hẹn về kho. Bỏ trống = Thứ 2, 4, 6, Chủ nhật.
# AUDIOBOOK_RELEASE_WEEKDAYS=0,2,4,6
# 0 = không dựng, không đăng, không hẹn Short nào (stage 7/7b bỏ, post_shorts 20:05 thoát luôn).
# AUDIOBOOK_SHORTS=1

# Cách dựng hình (27/11/2026): frame = khung tĩnh + video nền (mặc định);
# stickman = hoạt hình người que bằng bộ lệnh lemo/stickman/kit (chỉ định dạng full).
# Stage 3-7 thay bằng Stage 4s: import kịch bản + giọng đọc, mô hình viết phân cảnh,
# vẽ ~150 tranh (7,5-9,5 giờ -> lượt 09:00 xong khoảng 17-19 giờ), dựng, soạn bộ tệp
# đăng; stage 8/9 (kho, hẹn 20:00) giữ nguyên. Không có bước xem tranh: ~10% tranh lỗi lọt.
# AUDIOBOOK_RENDERER=frame
# STICK_KIT=/Users/lee/Project/Apps/lemo/stickman/kit

# Giám đốc kênh (28/11/2026): ngày phát của kênh phụ Xóm Que Kể Chuyện, 0 = Thứ Hai. Kênh chính dùng AUDIOBOOK_RELEASE_WEEKDAYS.
AUDIOBOOK_RELEASE_WEEKDAYS_XOMQUE=0,3,5
